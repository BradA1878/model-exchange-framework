{
  "name": "fog-of-war-game",
  "version": "1.0.0",
  "description": "Fog of War: Parallel Minds - MXF Multi-Agent Strategy Game Demo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:client": "bun run --cwd client build",
    "build:all": "bun run build && bun run build:client",
    "dev": "bun run server/index.ts",
    "dev:client": "bun run --cwd client dev",
    "connect-agents": "NODE_ENV=development bun run connect-agents.ts",
    "game": "bun run run-demo.ts",
    "start": "bun run dist/index.js",
    "clean": "rm -rf dist && rm -rf client/dist",
    "rebuild": "bun run clean && bun run build:all"
  },
  "keywords": ["mxf", "multi-agent", "game", "strategy", "demo"],
  "author": "MXF Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/cors": "^2.8.13",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.1"
  }
}
