{
  "name": "twenty-questions-game",
  "version": "1.0.0",
  "description": "Twenty Questions: ORPAR Cognitive Cycle Demo - Two AI agents play 20 Questions showcasing the Observe-Reason-Plan-Act-Reflect cycle",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:client": "bun run --cwd client build",
    "build:all": "bun run build && bun run build:client",
    "dev": "bun run server/index.ts",
    "dev:client": "bun run --cwd client dev",
    "connect-agents": "NODE_ENV=development TENSORFLOW_ENABLED=true bun run connect-agents.ts",
    "game": "bun run run-demo.ts",
    "start": "bun run dist/index.js",
    "clean": "rm -rf dist && rm -rf client/dist",
    "rebuild": "bun run clean && bun run build:all"
  },
  "keywords": [
    "mxf",
    "multi-agent",
    "game",
    "twenty-questions",
    "orpar",
    "cognitive-cycle",
    "demo"
  ],
  "author": "MXF Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "socket.io": "^4.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
